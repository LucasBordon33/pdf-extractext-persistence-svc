# ============================================================================
# pdf-extractext-persistence-svc - Plantilla de configuración de entorno
# ============================================================================
#
# Uso:
#   1. Copia este archivo como `.env` en la raíz del proyecto:
#        cp .env.example .env
#   2. Ajusta los valores según el entorno (desarrollo local, staging,
#      producción). En despliegues orquestados (Docker, k8s, etc.) prefiere
#      inyectar variables de entorno reales en lugar del archivo `.env`.
#
# Reglas de carga:
#   - El archivo `.env` es leído ÚNICAMENTE por la capa de configuración
#     (`app/config.py`, clase `Settings` de pydantic-settings).
#   - Solo el bootstrap (`app/main.py`) instancia `Settings` e inyecta los
#     valores al resto de componentes. Ninguna otra capa accede a variables
#     de entorno ni a este archivo.
#   - Precedencia (de mayor a menor): variable de entorno real > archivo
#     `.env` > valor por defecto.
#   - Todas las variables son opcionales: si no se definen, aplican los
#     valores por defecto, pensados para desarrollo local con MongoDB y
#     Redis accesibles en localhost.
# ============================================================================


# ----------------------------------------------------------------------------
# ENTORNO DE LA APLICACIÓN
# ----------------------------------------------------------------------------

# ENVIRONMENT
#   Qué representa: identificador del entorno de ejecución del servicio.
#   Cuándo se utiliza: al iniciar la aplicación; el bootstrap instancia la
#     configuración y la inyecta a los componentes que la requieren.
#   Valor por defecto: development
#   Impacto funcional: permite distinguir el contexto de despliegue
#     (desarrollo, pruebas, producción) sin alterar el comportamiento del
#     servicio; es informativo y no habilita lógicas condicionales.
ENVIRONMENT=development

# LOG_LEVEL
#   Qué representa: nivel mínimo de severidad de los mensajes de log
#     (DEBUG, INFO, WARNING, ERROR, CRITICAL).
#   Cuándo se utiliza: al arrancar, para fijar la verbosidad del logging del
#     servicio.
#   Valor por defecto: INFO
#   Impacto funcional: controla la cantidad de detalle diagnóstico emitido.
#     En producción se recomienda INFO o superior para evitar ruido y coste
#     de E/S; en desarrollo, DEBUG facilita el diagnóstico.
LOG_LEVEL=INFO

# HOST
#   Qué representa: interfaz de red en la que el servidor HTTP (uvicorn)
#     escucha peticiones.
#   Cuándo se utiliza: al arrancar el servidor desde el bootstrap
#     (`python -m app.main`).
#   Valor por defecto: 0.0.0.0 (escucha en todas las interfaces; necesario
#     dentro de contenedores). Usa 127.0.0.1 para restringir al host local.
#   Impacto funcional: determina desde qué redes es alcanzable el servicio;
#     un valor incorrecto provoca conexiones rechazadas o exposición no
#     deseada del puerto.
HOST=0.0.0.0

# PORT
#   Qué representa: puerto TCP donde el servidor HTTP expone la API.
#   Cuándo se utiliza: al arrancar el servidor desde el bootstrap.
#   Valor por defecto: 8003 (puerto asignado a este microservicio dentro
#     del sistema pdf-extractext).
#   Impacto funcional: define el endpoint de red del servicio; otros
#     componentes del sistema deben apuntar a este puerto para persistir o
#     consultar documentos.
PORT=8003

# ----------------------------------------------------------------------------
# PERSISTENCIA (MongoDB - fuente de verdad)
# ----------------------------------------------------------------------------

# MONGO_URI
#   Qué representa: cadena de conexión al servidor/cluster MongoDB.
#   Cuándo se utiliza: al construir el cliente asíncrono (motor) durante la
#     composición en el bootstrap.
#   Valor por defecto: mongodb://localhost:27017
#   Impacto funcional: MongoDB es la fuente de verdad del servicio; sin
#     conectividad no es posible almacenar ni consultar documentos. Incluye
#     credenciales y opciones de réplica según el entorno.
MONGO_URI=mongodb://localhost:27017

# MONGO_DB
#   Qué representa: nombre de la base de datos MongoDB usada por el servicio.
#   Cuándo se utiliza: en cada operación de persistencia y consulta de
#     documentos.
#   Valor por defecto: pdf_documents
#   Impacto funcional: aisla los datos de este microservicio; compartir base
#     de datos con otros servicios provoca colisiones de colecciones y datos
#     inconsistentes.
MONGO_DB=pdf_documents

# ----------------------------------------------------------------------------
# CACHE E IDEMPOTENCIA (Redis)
# ----------------------------------------------------------------------------

# REDIS_URL
#   Qué representa: URL de conexión a Redis (esquema redis://host:port/db).
#   Cuándo se utiliza: al construir el cliente asíncrono (redis.asyncio)
#     durante la composición en el bootstrap.
#   Valor por defecto: redis://localhost:6379/0
#   Impacto funcional: habilita la caché de lecturas y los locks de
#     idempotencia de escrituras. Sin Redis, el servicio pierde rendimiento
#     en consultas repetidas y protección frente a escrituras duplicadas.
REDIS_URL=redis://localhost:6379/0

# CACHE_TTL_SECONDS
#   Qué representa: tiempo de vida, en segundos, de las entradas de caché
#     almacenadas en Redis.
#   Cuándo se utiliza: al escribir cada entrada en la caché, como expiración
#     de la clave.
#   Valor por defecto: 300 (5 minutos)
#   Impacto funcional: define el balance entre frescura de los datos
#     servidos y la carga impuesta a MongoDB. Valores altos reducen latencia
#     pero pueden servir datos desactualizados tras una escritura.
CACHE_TTL_SECONDS=300

# LOCK_TTL_SECONDS
#   Qué representa: tiempo de vida, en segundos, del lock distribuido que
#     garantiza idempotencia de escrituras en Redis.
#   Cuándo se utiliza: al adquirir el lock (por checksum/identificador del
#     documento) antes de persistir una escritura.
#   Valor por defecto: 10
#   Impacto funcional: acota la ventana de de-duplicación de escrituras
#     concurrentes o reintentadas. Valores muy altos pueden bloquear
#     reintentos legítimos; muy bajos permiten duplicados si el procesamiento
#     demora más que la ventana.
LOCK_TTL_SECONDS=10
