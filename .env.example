ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8003

MONGO_URI=mongodb://mongodb:27017

MONGO_DB=pdf_documents

REDIS_URL=REDIS_URL=redis://redis:6379/0

CACHE_TTL_SECONDS=300

LOCK_TTL_SECONDS=10

SERVICE_DISCOVERY_ENABLED=true
CONSUL_HOST=consul
CONSUL_PORT=8500
SERVICE_NAME=store
SERVICE_ID=
SERVICE_HOST=
SERVICE_ADDRESS_MODE=ip
SERVICE_PORT=8003
SERVICE_HEALTH_PATH=/api/v1/health
HEALTH_CHECK_INTERVAL=10s
HEALTH_CHECK_TIMEOUT=5s
DEREGISTER_CRITICAL_AFTER=60s
CONSUL_REGISTER_RETRIES=1
CONSUL_REGISTER_BACKOFF=0.5
CONSUL_TIMEOUT=2.0
